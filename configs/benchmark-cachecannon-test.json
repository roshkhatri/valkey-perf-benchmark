[
  {
    "test_groups": [
      {
        "group": 1,
        "description": "Cachecannon GET/SET smoke test",
        "scenarios": [
          {
            "id": "set",
            "type": "write",
            "command": "SET",
            "data_size": 16,
            "pipeline": 32,
